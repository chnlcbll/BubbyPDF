{
  "_about": "Themes for a PDF reader/editor, adapted from replica-entrepreneur's defaults. Patterns are case-insensitive Python regexes.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease add\\b", "\\bwould be (nice|great|good|helpful)\\b", "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b", "\\bno way to\\b", "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off|paste|rotate|merge|sign|fill|save)\\b",
    "\\b(missing|lacks|lacking)\\b", "\\bdoesn'?t (have|support|let|allow)\\b", "\\bif only\\b",
    "\\bfeature request\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b", "\\bi suggest\\b"
  ],
  "themes": [
    {"id": "pricing", "label": "Price, subscription and paywalls", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bpaywall", "\\bpay.?wall\\b", "\\bsubscri(be|ption)", "\\bper (month|year)\\b", "\\ba (month|year)\\b", "\\bpremium\\b", "\\bnot worth\\b", "\\bpay (for|us)\\b", "\\bafford\\b", "\\$\\d"]},
    {"id": "billing", "label": "Trials, cancelling, fees and refunds", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bcancel", "\\bauto.?renew", "\\bearly (termination|cancel)", "\\bfree tri[ae]l\\b", "\\bbilling\\b", "\\bscam\\b", "\\bdebit\\b", "\\bannual (plan|subscription)\\b"]},
    {"id": "upsell", "label": "Upsell pop-ups, ads and nagging", "kind": "complaint",
     "patterns": ["\\bpop.?ups?\\b", "\\bpopping up\\b", "\\bads\\b", "\\bupsell", "\\bnag", "\\bharass", "\\bmarketing\\b", "\\bupgrade\\b", "\\bnotifications?\\b", "\\bspam", "\\bliquid (mode|view)\\b", "\\bwelcome doc"]},
    {"id": "ai", "label": "AI assistant pushed on users", "kind": "complaint",
     "patterns": ["\\bai\\b", "\\ba\\.i\\b", "\\bai assistant\\b", "\\bcopilot\\b", "\\bchat ?gpt\\b", "\\bartificial intelligence\\b"]},
    {"id": "editing", "label": "Editing text is locked or broken", "kind": "complaint",
     "patterns": ["\\bedit(ing)? (the )?text\\b", "\\btext edit", "\\bedit (a|my|the) (pdf|document|doc)\\b", "\\bedit pdfs?\\b", "\\bto edit\\b", "\\btext box", "\\bfont\\b", "\\bmoving text\\b"]},
    {"id": "forms", "label": "Fill & sign and forms got worse", "kind": "complaint",
     "patterns": ["\\bfill (and|&) sign\\b", "\\bfill(ing)? (out|in)\\b", "\\bforms?\\b", "\\bsignature", "\\bsign (it|a|the|documents?)\\b", "\\bcheck ?marks?\\b", "\\besign\\b", "\\bfields?\\b"]},
    {"id": "lostwork", "label": "Lost work, failed saves, corrupt files", "kind": "complaint",
     "patterns": ["\\bloses? (everything|all|my)\\b", "\\blost (my|all|everything)\\b", "\\bwon'?t save\\b", "\\bnot save\\b", "\\bdoesn'?t save\\b", "\\brefused to save\\b", "\\bcorrupt", "\\bdamaged\\b", "\\berror saving\\b", "\\bdisappear", "\\bwithout saving\\b"]},
    {"id": "bugs", "label": "Bugs, crashes and freezes", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\bnot responding\\b", "\\blocks up\\b", "\\bhangs\\b"]},
    {"id": "performance", "label": "Slow, heavy, bloated", "kind": "complaint",
     "patterns": ["\\bslow(er)?\\b", "\\blag(gy|s)?\\b", "\\btakes forever\\b", "\\bsluggish\\b", "\\bheavy\\b", "\\bbloat", "\\bresource", "\\bmemory\\b", "\\bcpu\\b", "\\bstartup\\b"]},
    {"id": "cloud", "label": "Forced sign-in, cloud and privacy", "kind": "complaint",
     "patterns": ["\\bsign ?in\\b", "\\blog ?in\\b", "\\baccount\\b", "\\bcloud\\b", "\\bonline\\b", "\\bservers?\\b", "\\bprivacy\\b", "\\btrack(ing)?\\b", "\\bpermission\\b", "\\binvasive\\b", "\\btelemetry\\b"]},
    {"id": "ux", "label": "Confusing, clunky, worse after redesign", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bhard to (use|find|navigate|get out)\\b", "\\bcomplicat", "\\bcluttered\\b", "\\bunintuitive\\b", "\\bnot (super )?intuitive\\b", "\\bclunky\\b", "\\bused to be\\b", "\\bolder version\\b", "\\bnew (update|version|design)\\b", "\\bredesign", "\\bafter (some |the )?updates?\\b"]},
    {"id": "support", "label": "Support that does not answer", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport (team|is|was)\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bhung up\\b"]},
    {"id": "search", "label": "Search and navigation", "kind": "request",
     "patterns": ["\\bsearch\\b", "\\bfind (a |the )?word\\b", "\\bgo back\\b", "\\bnavigation\\b", "\\blinks?\\b", "\\bbookmarks?\\b", "\\bfile browser\\b"]},
    {"id": "pages", "label": "Organize pages: merge, rotate, split, n-up", "kind": "request",
     "patterns": ["\\bmerge\\b", "\\bcombine\\b", "\\brotate\\b", "\\bsplit\\b", "\\bextract\\b", "\\breorder\\b", "\\borganize\\b", "\\bpages? per (page|sheet)\\b", "\\b(two|four|2|4) per page\\b", "\\bdelete pages?\\b"]},
    {"id": "convert", "label": "Convert, export, compress, OCR", "kind": "request",
     "patterns": ["\\bconvert", "\\bexport\\b", "\\bto word\\b", "\\bcompress", "\\bocr\\b", "\\bscan(ned)?\\b", "\\bjpe?g\\b", "\\bimages?\\b"]},
    {"id": "linux", "label": "Platforms: Linux, offline, no installer", "kind": "request",
     "patterns": ["\\blinux\\b", "\\boffline\\b", "\\bportable\\b", "\\binstaller\\b", "\\bmac(os)?\\b", "\\bwindows\\b"]},
    {"id": "readaloud", "label": "Read aloud and dark mode", "kind": "request",
     "patterns": ["\\bread aloud\\b", "\\bdark mode\\b", "\\bnight mode\\b", "\\btext.to.speech\\b"]}
  ]
}
